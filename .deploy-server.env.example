# ./deploy-server (bin/deploy-server.sh) 접속 정보 예시.
# 이 파일을 .deploy-server.env 로 복사해서 값을 채우세요.  .deploy-server.env 는 .gitignore 대상입니다.
#
#   cp .deploy-server.env.example .deploy-server.env

# 게임 서버 도메인 (Caddy 가 TLS 를 받는 이름). wss:// 확인도 이 주소로 합니다.
DEPLOY_HOST=game.example.com

# SSH 사용자. Oracle Ubuntu 이미지는 ubuntu 입니다.
DEPLOY_USER=ubuntu

# SSH 개인키 경로.
DEPLOY_KEY=~/.ssh/oracle.key
